{
  "name": "ob2wechat",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.3",
  "description": "Live WeChat Official Account preview and rich-text copy for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:test": "node scripts/deploy-test-vault.mjs",
    "verify": "pnpm test && pnpm build && pnpm deploy:test"
  },
  "keywords": [
    "obsidian",
    "wechat",
    "markdown",
    "publisher"
  ],
  "author": "joahyi-ai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^28.0.0",
    "obsidian": "latest",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
